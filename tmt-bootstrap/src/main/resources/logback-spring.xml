<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 콘솔 출력 (패턴 포맷) -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS}|%5p|%-8X{requestId:- }|%-40.40logger{39}|%m%n%wEx</pattern>
            <charset>utf8</charset>
        </encoder>
    </appender>

    <!-- local 프로필 -->
    <springProfile name="local">
        <logger name="com.tmt" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.hibernate.orm.jdbc.bind" level="WARN"/>
        <root level="INFO">
            <appender-ref ref="STDOUT"/>
        </root>
    </springProfile>

    <!-- prod 프로필 -->
    <springProfile name="prod">
        <!-- 값 정본은 application-prod.yml -->
        <springProperty scope="context" name="sentryDsn" source="sentry.dsn" defaultValue=""/>
        <springProperty scope="context" name="sentryRelease" source="sentry.release" defaultValue=""/>

        <!-- 레벨 기준은 docs/LOGGING.md. ERROR만 이벤트가 되고(5xx·기동 점검), 그 아래는
             breadcrumb으로만 이벤트에 딸려 간다 (TMT-354) -->
        <appender name="SENTRY" class="io.sentry.logback.SentryAppender">
            <options>
                <dsn>${sentryDsn}</dsn>
                <environment>prod</environment>
                <release>${sentryRelease}</release>
                <maxBreadcrumbs>100</maxBreadcrumbs>
                <sendDefaultPii>false</sendDefaultPii>
                <contextTag>requestId</contextTag>
            </options>
            <minimumEventLevel>ERROR</minimumEventLevel>
            <minimumBreadcrumbLevel>INFO</minimumBreadcrumbLevel>
        </appender>

        <logger name="com.tmt" level="INFO"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
        <root level="INFO">
            <appender-ref ref="STDOUT"/>
            <appender-ref ref="SENTRY"/>
        </root>
    </springProfile>
</configuration>
