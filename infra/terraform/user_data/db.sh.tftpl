#!/bin/bash
set -euo pipefail

# --- 스왑 2GiB (TMT-298) ---
# t3.micro(916MB)는 스왑이 없으면 메모리 스파이크가 곧 유저랜드 동결이다 — SSM 에이전트까지
# 죽어 복구 수단이 사라진다 (2026-09-01 v0.1.0 배포 장애). 스왑은 동결을 일시 지연으로 바꾼다.
# swappiness=10 — 평상시에는 안 쓰고 압박 시에만 밀어낸다.
if ! swapon --show --noheadings | grep -q /swapfile; then
  fallocate -l 2G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
fi
grep -q "^/swapfile" /etc/fstab || echo "/swapfile none swap sw 0 0" >> /etc/fstab
echo "vm.swappiness=10" > /etc/sysctl.d/99-tmt-swap.conf
sysctl -p /etc/sysctl.d/99-tmt-swap.conf

dnf install -y docker
systemctl enable --now docker

# --- 데이터 볼륨 준비 ---
# Nitro 인스턴스(t3)에서는 attach 시 지정한 /dev/sdf 이름이 그대로 보이지 않고
# /dev/nvme1n1 식으로 잡힌다. 순서도 보장되지 않으므로 볼륨 ID로 심링크를 찾는다.
VOL_SERIAL=$(echo "${volume_id}" | tr -d '-')
DEV="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$VOL_SERIAL"

for _ in $(seq 1 60); do
  [ -e "$DEV" ] && break
  sleep 5
done

if [ ! -e "$DEV" ]; then
  echo "data volume ${volume_id} did not appear" >&2
  exit 1
fi

# 이미 파일시스템이 있으면 절대 다시 만들지 않는다. 인스턴스 교체 후 재부팅에서
# 여기가 무조건 mkfs를 하면 기존 DB가 통째로 날아간다.
if ! blkid "$DEV" >/dev/null 2>&1; then
  mkfs.ext4 -L tmtpgdata "$DEV"
fi

mkdir -p /mnt/pgdata
UUID=$(blkid -s UUID -o value "$DEV")
# nofail: 볼륨이 없을 때 부팅이 멈추는 대신 올라오게 한다(SSM으로 진입해 복구 가능)
grep -q "$UUID" /etc/fstab || echo "UUID=$UUID /mnt/pgdata ext4 defaults,nofail 0 2" >> /etc/fstab
mount -a

# ext4 루트에는 lost+found가 있어 initdb가 "디렉토리가 비어있지 않다"며 거부한다.
# 하위 디렉토리를 PGDATA로 쓴다.
mkdir -p /mnt/pgdata/data

# --- 비밀번호 주입 ---
# user_data는 인스턴스 메타데이터로 조회되므로 여기에 평문을 넣지 않는다.
# 인스턴스 IAM 역할로 SSM에서 읽어 600 파일로 떨군 뒤 컨테이너에 파일로 넘긴다.
# (-e POSTGRES_PASSWORD 로 넘기면 docker inspect에 그대로 남는다)
mkdir -p /etc/tmt
chmod 700 /etc/tmt
# 부팅 직후에는 인스턴스 역할 자격증명 전파가 늦어 이 호출이 한 번 실패하는 일이 있다.
# set -euo pipefail 아래에서 그 일시적 실패 하나가 user_data 전체를 죽이면 DB가 뜨지 않는다.
# 위 볼륨 대기 루프와 같은 패턴으로 재시도한다.
for _ in $(seq 1 30); do
  if aws ssm get-parameter \
      --region "${region}" \
      --name "${password_param}" \
      --with-decryption \
      --query 'Parameter.Value' \
      --output text > /etc/tmt/db_password 2>/dev/null; then
    break
  fi
  sleep 5
done

# 빈 파일을 그대로 넘기면 initdb가 비밀번호 없는 DB를 만들어버린다. 확실히 실패시킨다.
if [ ! -s /etc/tmt/db_password ]; then
  echo "failed to read ${password_param} from SSM" >&2
  exit 1
fi
chmod 600 /etc/tmt/db_password

# --- PostgreSQL 기동 ---
# 5432를 호스트에 바인딩한다. 노출면은 보안그룹이 WAS 보안그룹으로만 제한한다.
docker run -d \
  --name postgres \
  --restart unless-stopped \
  -p 5432:5432 \
  -v /mnt/pgdata/data:/var/lib/postgresql/data \
  -v /etc/tmt/db_password:/run/secrets/db_password:ro \
  -e POSTGRES_DB="${postgres_db}" \
  -e POSTGRES_USER="${postgres_user}" \
  -e POSTGRES_PASSWORD_FILE=/run/secrets/db_password \
  "${postgres_image}"

# pgvector는 PostGIS 이미지에 들어있지 않을 수 있다. 확장 생성은 애플리케이션
# 마이그레이션(Flyway 등)에서 CREATE EXTENSION으로 처리한다 — TMT-61에서 확정.

# --- 백업 ---
# RDS 자동 스냅샷이 없으므로 pg_dump를 직접 돌린다. EBS 분리(prevent_destroy)는
# 인스턴스 교체를 견디게 해줄 뿐, 볼륨 자체가 깨지거나 데이터를 잘못 지운 경우는
# 못 막는다. 그 경우의 유일한 복구 수단이 이 덤프다.
cat > /usr/local/bin/tmt-pg-backup.sh <<'EOS'
#!/bin/bash
set -euo pipefail

BUCKET="${backup_bucket}"
REGION="${region}"
DB="${postgres_db}"
DBUSER="${postgres_user}"

# Persistent=true가 부팅 직후 놓친 회차를 따라잡을 때 docker는 떠 있어도 postgres
# 컨테이너는 아직 준비 전일 수 있다. 여기서 바로 실패하면 그 회차가 그대로 소진되어
# 다음 OnCalendar까지 백업이 빈다. 위 데이터 볼륨 대기 루프와 같은 패턴으로 기다린다.
for _ in $(seq 1 12); do
  docker inspect -f '{{.State.Running}}' postgres 2>/dev/null | grep -q true && break
  sleep 5
done

if ! docker inspect -f '{{.State.Running}}' postgres 2>/dev/null | grep -q true; then
  echo "postgres container is not running — skipping backup" >&2
  exit 1
fi

TS=$(date -u +%Y%m%dT%H%M%SZ)
PREFIX="pg/$(date -u +%Y/%m)"
OUT="/var/tmp/tmt-$TS.dump"
trap 'rm -f "$OUT"' EXIT

# -Fc: custom format. pg_restore로 선택 복구가 되고 자체 압축된다.
# 비밀번호는 컨테이너에 이미 마운트된 파일에서 읽는다 — 호스트 프로세스 목록에 남기지 않는다.
docker exec postgres bash -c "PGPASSWORD=\$(cat /run/secrets/db_password) pg_dump -U $DBUSER -d $DB -Fc" > "$OUT"

# 깨진 덤프를 올려놓고 백업이 됐다고 착각하는 게 최악이다. -Fc는 완전히 빈 DB라도
# 수백 바이트 아카이브 헤더를 만들어 크기 검사로는 걸러지지 않는다 — pg_restore가
# 목차를 읽을 수 있는지로 아카이브 유효성을 직접 확인한다.
# 파일 인자를 주지 않아야 stdin을 읽는다. '-'는 stdin이 아니라 파일명 리터럴로
# 해석되어("could not open input file \"-\"") 검사가 항상 실패한다.
if ! docker exec -i postgres pg_restore -l < "$OUT" >/dev/null 2>&1; then
  echo "dump is not a valid archive — aborting" >&2
  exit 1
fi

aws s3 cp "$OUT" "s3://$BUCKET/$PREFIX/tmt-$TS.dump" --region "$REGION"
echo "uploaded s3://$BUCKET/$PREFIX/tmt-$TS.dump ($(stat -c %s "$OUT") bytes)"
EOS
chmod 750 /usr/local/bin/tmt-pg-backup.sh

cat > /etc/systemd/system/tmt-pg-backup.service <<'EOS'
[Unit]
Description=TMT PostgreSQL dump to S3
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/tmt-pg-backup.sh
EOS

cat > /etc/systemd/system/tmt-pg-backup.timer <<'EOS'
[Unit]
Description=TMT PostgreSQL backup schedule

[Timer]
OnCalendar=${backup_schedule}
# 인스턴스가 꺼져 있어 놓친 실행을 부팅 후 따라잡는다
Persistent=true

[Install]
WantedBy=timers.target
EOS

systemctl daemon-reload
systemctl enable --now tmt-pg-backup.timer

# --- 스왑 관측 (TMT-303) ---
# 스왑(TMT-298)은 장애를 "죽음"에서 "느린 채 살아 있음"으로 바꾼다 — 관측이 없으면 열화를 아무도 모른다.
# 5분마다 CloudWatch TMT/Memory에 4개 지표를 올린다: SwapUsedPercent · MemAvailableMB ·
# SwapInPages · SwapOutPages(직전 실행 이후 델타). 상향 판단 기준은 infra/terraform/README.md §스왑 관측.
cat > /usr/local/bin/tmt-swap-metrics.sh <<'EOS'
#!/bin/bash
set -euo pipefail
ROLE="db"
STATE=/var/lib/tmt/swap-metrics.state
mkdir -p "$(dirname "$STATE")"

TOKEN=$(curl -sS -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
REGION=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/region)

read -r _ swap_total < <(grep '^SwapTotal:' /proc/meminfo)
read -r _ swap_free  < <(grep '^SwapFree:'  /proc/meminfo)
read -r _ mem_avail  < <(grep '^MemAvailable:' /proc/meminfo)
pswpin=$(awk '/^pswpin/ {print $2}' /proc/vmstat)
pswpout=$(awk '/^pswpout/ {print $2}' /proc/vmstat)

swap_used_pct=0
if [ "$swap_total" -gt 0 ]; then
  swap_used_pct=$(( (swap_total - swap_free) * 100 / swap_total ))
fi

# 직전 실행과의 델타 — 첫 실행이나 재부팅(카운터 리셋)이면 0으로 본다
prev_in=0; prev_out=0
[ -f "$STATE" ] && read -r prev_in prev_out < "$STATE"
d_in=$(( pswpin - prev_in ));  [ "$d_in"  -lt 0 ] && d_in=0
d_out=$(( pswpout - prev_out )); [ "$d_out" -lt 0 ] && d_out=0
echo "$pswpin $pswpout" > "$STATE"

aws cloudwatch put-metric-data --region "$REGION" --namespace TMT/Memory --metric-data \
  "MetricName=SwapUsedPercent,Dimensions=[{Name=Role,Value=$ROLE}],Value=$swap_used_pct,Unit=Percent" \
  "MetricName=MemAvailableMB,Dimensions=[{Name=Role,Value=$ROLE}],Value=$(( mem_avail / 1024 )),Unit=Megabytes" \
  "MetricName=SwapInPages,Dimensions=[{Name=Role,Value=$ROLE}],Value=$d_in,Unit=Count" \
  "MetricName=SwapOutPages,Dimensions=[{Name=Role,Value=$ROLE}],Value=$d_out,Unit=Count"
EOS
chmod +x /usr/local/bin/tmt-swap-metrics.sh

cat > /etc/systemd/system/tmt-swap-metrics.service <<'EOS'
[Unit]
Description=TMT swap/memory metrics to CloudWatch (TMT-303)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/tmt-swap-metrics.sh
EOS

cat > /etc/systemd/system/tmt-swap-metrics.timer <<'EOS'
[Unit]
Description=Run tmt-swap-metrics every 5 minutes

[Timer]
OnCalendar=*:0/5
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
EOS
systemctl daemon-reload
systemctl enable --now tmt-swap-metrics.timer
