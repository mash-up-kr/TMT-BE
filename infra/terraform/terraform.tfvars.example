# terraform.tfvars 는 **없어도 된다.** 변수 기본값(variables.tf)이 라이브 구성을 그대로 담고 있어서,
# clone 후 `terraform init && terraform plan`이 바로 돈다 (plan은 No changes가 정상).
#
# 이 파일은 기본값과 다르게 쓰고 싶을 때만 복사해서 채운다:
#   cp terraform.tfvars.example terraform.tfvars
# terraform.tfvars 는 .gitignore 대상 — 커밋하지 않는다.

# EC2에 등록할 SSH 공개키. 기본값으로 팀 공개키가 들어 있어 생략 가능하다.
# 본인 키로 바꾸려면 여기서 덮어쓴다. (공개키라 시크릿이 아니다)
# ssh_public_key = "ssh-ed25519 AAAAC3Nza... me@laptop"

# 비상용 SSH 허용 대역. 기본값은 빈 목록(전면 차단)이고,
# 평상시 접속은 SSM Session Manager를 쓴다:
#   aws ssm start-session --target i-xxxxxxxx
# was_ssh_cidrs = ["203.0.113.10/32"]
#
# DB는 별도 변수다. WAS와 공유하지 않으므로 위를 열어도 DB의 22번은 닫혀 있다.
# DB는 SSM으로만 접속하고 빈 목록을 유지하는 것을 권한다.
# db_ssh_cidrs = []

# 앱 포트 공개 범위. 도그푸딩 중 외부 공개가 필요 없으면 팀 IP로 좁힌다.
# app_ingress_cidrs = ["203.0.113.10/32"]

# 아래는 기본값이 곧 라이브 값이다. 바꾸면 실제 인스턴스가 교체되므로 팀 합의 후에 건드린다.
# region            = "ap-northeast-2"
# az                = "ap-northeast-2a"
# was_instance_type = "t3.micro"
# db_instance_type  = "t3.micro"
